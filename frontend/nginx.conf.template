# nginx serves the built SPA and proxies /api to the backend, so the browser makes
# same-origin requests (no CORS in prod) — mirrors the Vite dev proxy (vite.config.js).
#
# Template (not a static .conf): PORT/BACKEND_URL/DNS_RESOLVER are substituted at
# container start by nginx:1.27-alpine's built-in envsubst-on-templates entrypoint step
# (only variables that are actually set in the environment get replaced — nginx's own
# runtime variables like $host below are untouched, since they aren't env vars). This
# is what lets the SAME image run unmodified in both places:
#   docker-compose (local): PORT=80, BACKEND_URL=http://backend:5000 (Dockerfile ENV
#     defaults), DNS_RESOLVER=127.0.0.11 (Docker's embedded DNS).
#   Cloud Run: PORT=8080 (Cloud Run always injects this), BACKEND_URL=the backend
#     Cloud Run service's HTTPS URL, DNS_RESOLVER=a public resolver — all set by
#     scripts/gcloud_deploy_app.sh via `gcloud run deploy --set-env-vars`.
server {
    listen ${PORT};
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Reject oversize uploads at the edge (keep in sync with backend MAX_UPLOAD_MB=10),
    # so a huge body is dropped before it ever streams to Flask.
    client_max_body_size 10m;

    # Baseline security headers (defense-in-depth; the backend also sets these on /api).
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "no-referrer" always;

    # API → backend. Resolved at REQUEST time via a variable (not a literal proxy_pass),
    # so nginx starts even if the backend isn't up yet and survives a backend
    # restart/IP change / Cloud Run URL change.
    location /api/ {
        resolver ${DNS_RESOLVER} valid=10s;
        set $backend_upstream ${BACKEND_URL};
        proxy_pass $backend_upstream;
        # $proxy_host (the resolved upstream's own host:port), NOT $host (the
        # incoming client request's Host — this frontend's own hostname). Forwarding
        # the client's Host works by accident for docker-compose's `backend:5000`
        # (nothing there routes on Host), but breaks Cloud Run: its front end routes
        # *.run.app traffic BY Host header, so sending the frontend's own Host while
        # connecting to the backend's address fails to reach the backend service.
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300s;   # survive a cold guard / VLM call
        proxy_ssl_server_name on; # correct TLS SNI when BACKEND_URL is https (Cloud Run)
        # /api/ask/stream (Server-Sent Events): the backend already sends
        # X-Accel-Buffering: no, which nginx honors per-response — this directive is
        # belt-and-suspenders so streamed chunks reach the browser as they're written
        # instead of waiting for nginx's response buffer to fill/close.
        proxy_buffering off;
    }

    # SPA fallback: unknown paths return index.html for client-side routing.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
