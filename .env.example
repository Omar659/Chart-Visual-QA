# Copy to .env (gitignored) and adjust. The backend loads this at startup
# (backend/app.py -> python-dotenv). Real shell env vars take precedence over .env.

# --- Inference (mock vs real model) ---
USE_MOCK=1                 # 1 = mock answers; 0 = call model_adapter.predict
MOCK_DELAY_S=0             # artificial mock latency (s); >0 to see the loading state
MOCK_REVEAL=0             # 1 = mock returns the canned answer instead of a disclaimer

# --- Real model: Qwen3-VL (+ LoRA), used only when USE_MOCK=0 (see model_adapter.py) ---
# Serving mode: leave VLM_URL EMPTY to run the model IN-PROCESS (dev on a big GPU; the
# 8B does NOT fit the 6 GB 4050). Set it to a remote VLM service URL (production
# scale-to-zero GPU path, see vlm_service/) and the backend POSTs {image, question}
# there instead of loading the model. VLM_TIMEOUT is generous to survive a cold start.
VLM_URL=
VLM_TIMEOUT=120
# Who starts/warms the remote VLM (see backend/vlm_provider.py):
#   none      (default) VLM_URL is assumed always-on.
#   cloudrun  Cloud Run's own autoscaler starts an instance on request; warm() just
#             sends an early nudge (GET /api/vlm/warm, called by the frontend on load).
#   runpod    dev only — provisions a RunPod pod on demand (scripts/runpod_up.py).
#             Set by `python app.py --dev --runpod`; don't set this in docker-compose's .env.
VLM_PROVIDER=none
QWEN_MODEL_ID=Qwen/Qwen3-VL-8B-Instruct             # base VLM, downloaded from HF on first run
QWEN_ADAPTER_PATH=checkpoints/qwen3vl-lora-final2    # LoRA adapter dir; '' = base model only
# Opt-in bitsandbytes quantization: none | 8bit | 4bit (4bit = NF4 + double quant,
# bf16 compute). Requires `pip install bitsandbytes`; the loader fails loudly if it
# is requested but missing. Quantized runs keep the LoRA adapter attached (no merge).
QWEN_QUANTIZATION=none
QWEN_MAX_NEW_TOKENS=64                               # generation budget for the answer
QWEN_ANSWER_SUFFIX=" Please answer directly."        # appended to the question (terse answers)

# --- Server / uploads ---
HOST=127.0.0.1           # bind address; compose overrides to 0.0.0.0 in the container
PORT=5000
FLASK_DEBUG=1            # 1 = Flask reloader/debug (local); compose sets 0 in the container
CORS_ORIGINS=*          # dev: '*'. Prod: pin to your frontend origin(s), comma-separated
                        # e.g. https://charts.example.com,https://www.example.com
MAX_UPLOAD_MB=10          # reject larger uploads (keep in sync with frontend MAX_BYTES)
MIN_QUESTION_ALNUM=3      # min alphanumeric chars before a question counts as "real"

# --- Answer cache: short-circuits guard+chart+VLM on a repeat (image, question) ---
# In-memory LRU (single worker); Redis is the prod backend (Phase 3.6). Real answers only.
ANSWER_CACHE_ENABLED=1
ANSWER_CACHE_MAX=512      # max entries before evicting the least-recently-used
ANSWER_CACHE_TTL_S=3600   # entry lifetime in seconds (0 = never expire)

# --- Data layer (Phase 3.6): shared Redis backend for cache + rate-limit + VLM budget ---
# EMPTY = in-memory fallbacks (dev / single worker). docker-compose sets this to
# redis://redis:6379/0 so the cache + counters are shared across gunicorn workers and
# survive a restart. Fail-open: an unreachable Redis falls back to in-memory, never errors.
REDIS_URL=

# --- Rate limiting (Phase 3.7): per-IP fixed window on /api/ask (Redis-backed when set) ---
RATELIMIT_ENABLED=1
RATELIMIT_PER_MINUTE=30   # max requests per client IP per minute (0 = unlimited)

# --- VLM daily budget circuit breaker (Phase 3.7): caps real GPU answers/day ---
# Past the budget, /api/ask returns 429 BEFORE touching the GPU (cache/guard/mock still
# work) so a bot can't run up the GPU bill. 0 = unlimited (the demo default).
VLM_DAILY_BUDGET=0

# --- Layer-2 guard: encoder classifiers (opt-in models via requirements-guard.txt) ---
GUARD_ENABLED=1
GUARD_TOXICITY_THRESHOLD=0.7
GUARD_INJECTION_THRESHOLD=0.8
GUARD_PII_THRESHOLD=0.6
GUARD_TOXICITY_MODEL=original
GUARD_INJECTION_MODEL=protectai/deberta-v3-base-prompt-injection-v2

# --- Layer-3 guard: Llama Guard via Ollama (dev) / vLLM (prod) ---
GUARD_LLM_ENABLED=1                       # ON by default; falls back + WARNS if unavailable
GUARD_LLM_URL=http://localhost:11434      # vLLM/prod: http://guard:8000 (see docs/ARCHITECTURE.md)
GUARD_LLM_MODEL=llama-guard3:1b
GUARD_LLM_TIMEOUT=20                       # generous enough to survive a cold model load
# Production only: HF token for the gated meta-llama/Llama-Guard-3-1B weights vLLM pulls.
# HF_TOKEN=

# --- Chart detector (Task A): CLIP zero-shot + OCR "has data" gate ---
CHART_CLIP_MODEL=openai/clip-vit-base-patch32
CHART_CLIP_THRESHOLD=0.5                   # P(chart) >= this AND has numeric data -> chart
CHART_MIN_DATA_DIGITS=2                    # min numeric chars OCR must find
# Pixel-heuristic fallback (used when CLIP/torch is unavailable):
CHART_SAMPLE_SIZE=128
CHART_MIN_BACKGROUND_RATIO=0.18
CHART_MAX_DISTINCT_COLORS=48
# Tesseract OCR engine: leave blank to use PATH (Linux/containers). On Windows
# point at the binary, e.g.:
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=
